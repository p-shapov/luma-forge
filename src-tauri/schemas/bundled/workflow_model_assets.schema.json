{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "luma-forge://schemas/bundled/workflow_model_assets.schema.json",
  "title": "WorkflowModelAssets",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "workflow_id", "revision", "model_assets"],
  "properties": {
    "$schema": { "const": "luma-forge://schemas/bundled/workflow_model_assets.schema.json" },
    "workflow_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$" },
    "revision": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "model_assets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "download_source", "install_comfyui_relative_path"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$" },
          "name": { "type": "string", "minLength": 1 },
          "download_source": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source_type", "repository_id", "file_path", "revision"],
            "properties": {
              "source_type": { "const": "huggingface" },
              "repository_id": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
              "file_path": { "type": "string", "minLength": 1 },
              "revision": { "type": "string", "minLength": 1 }
            }
          },
          "install_comfyui_relative_path": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
