{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "luma-forge://schemas/bundled/workflow_contract_requirements.schema.json",
  "title": "WorkflowContractRequirements",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "workflow_id", "revision", "contract_requirements"],
  "properties": {
    "$schema": { "const": "luma-forge://schemas/bundled/workflow_contract_requirements.schema.json" },
    "workflow_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$" },
    "revision": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "contract_requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["runtime_type", "endpoint_contract", "provisioner_contract"],
        "properties": {
          "runtime_type": { "const": "runpod" },
          "endpoint_contract": { "$ref": "#/$defs/reference" },
          "provisioner_contract": { "$ref": "#/$defs/reference" }
        }
      }
    }
  },
  "$defs": {
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "revision"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$" },
        "revision": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" }
      }
    }
  }
}
