{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "luma-forge://schemas/bundled/workflow_metadata.schema.json",
  "title": "WorkflowMetadata",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "id", "revision", "name", "runtime_preset", "requires_hugging_face_api_key", "required_volume_size_gb"],
  "properties": {
    "$schema": { "const": "luma-forge://schemas/bundled/workflow_metadata.schema.json" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$" },
    "revision": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "name": { "type": "string", "minLength": 1 },
    "runtime_preset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "revision"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$" },
        "revision": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" }
      }
    },
    "requires_hugging_face_api_key": { "type": "boolean" },
    "required_volume_size_gb": { "type": "integer", "minimum": 1 }
  }
}
