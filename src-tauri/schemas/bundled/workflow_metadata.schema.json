{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "luma-forge://schemas/bundled/workflow_metadata.schema.json",
  "title": "WorkflowMetadata",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "name", "runtime_preset", "requires_hugging_face_api_key", "required_volume_size_gb"],
  "properties": {
    "$schema": { "const": "luma-forge://schemas/bundled/workflow_metadata.schema.json" },
    "name": { "type": "string", "minLength": 1 },
    "runtime_preset": { "$ref": "luma-forge://schemas/bundled/reference.schema.json" },
    "requires_hugging_face_api_key": { "type": "boolean" },
    "required_volume_size_gb": { "type": "integer", "minimum": 1 }
  }
}
