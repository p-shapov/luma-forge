{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "luma-forge://schemas/bundled/layout.schema.json",
  "title": "BundledLayout",
  "type": "object",
  "additionalProperties": false,
  "required": ["entity", "path_pattern", "path_params", "files"],
  "properties": {
    "entity": {
      "type": "string",
      "enum": ["workflow_revision", "runtime_preset", "runtime_contract", "execution_schema"]
    },
    "path_pattern": { "type": "string", "minLength": 1 },
    "path_params": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "string",
        "enum": ["id", "revision", "file"]
      }
    },
    "files": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["schema"],
        "properties": {
          "schema": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
