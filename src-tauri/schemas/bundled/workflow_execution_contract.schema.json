{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "luma-forge://schemas/bundled/workflow_execution_contract.schema.json",
  "title": "WorkflowExecutionContract",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "workflow_id", "revision", "schema_ref", "input_bindings"],
  "properties": {
    "$schema": { "const": "luma-forge://schemas/bundled/workflow_execution_contract.schema.json" },
    "workflow_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$" },
    "revision": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "schema_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "revision"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$" },
        "revision": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" }
      }
    },
    "input_bindings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["value", "node_id", "path"],
        "properties": {
          "value": true,
          "node_id": { "type": "string", "minLength": 1 },
          "path": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
