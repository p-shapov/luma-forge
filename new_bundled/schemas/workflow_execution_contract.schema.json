{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "luma-forge://schemas/bundled/workflow_execution_contract.schema.json",
  "title": "WorkflowExecutionContract",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_ref", "input_bindings"],
  "properties": {
    "$schema": { "const": "luma-forge://schemas/bundled/workflow_execution_contract.schema.json" },
    "schema_ref": { "$ref": "luma-forge://schemas/bundled/reference.schema.json" },
    "input_bindings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["value", "node_id", "path"],
        "properties": {
          "value": true,
          "node_id": { "type": "string", "minLength": 1 },
          "path": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
