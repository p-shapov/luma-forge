{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "luma-forge://schemas/bundled/workflow_contract_requirements.schema.json",
  "title": "WorkflowContractRequirements",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "contract_requirements"],
  "properties": {
    "$schema": { "const": "luma-forge://schemas/bundled/workflow_contract_requirements.schema.json" },
    "contract_requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["runtime_type", "endpoint_contract", "provisioner_contract"],
        "properties": {
          "runtime_type": { "const": "runpod" },
          "endpoint_contract": { "$ref": "luma-forge://schemas/bundled/reference.schema.json" },
          "provisioner_contract": { "$ref": "luma-forge://schemas/bundled/reference.schema.json" }
        }
      }
    }
  }
}
