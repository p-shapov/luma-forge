{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "luma-forge://schemas/bundled/execution_schema.schema.json",
  "title": "ExecutionSchema",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "inputs", "outputs"],
  "properties": {
    "$schema": { "const": "luma-forge://schemas/bundled/execution_schema.schema.json" },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "required"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$" },
          "type": { "const": "string" },
          "required": { "type": "boolean" },
          "max_length": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "outputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "type": "string", "minLength": 1 }
      }
    }
  }
}
