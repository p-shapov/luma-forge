{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "luma-forge://schema/reference",
  "title": "Reference",
  "type": "object",
  "additionalProperties": false,
  "required": ["entity", "id", "revision"],
  "properties": {
    "entity": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "revision": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    }
  }
}
