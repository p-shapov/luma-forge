{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "luma-forge://schema/runtime_preset",
  "title": "RuntimePreset",
  "type": "object",
  "additionalProperties": false,
  "required": ["runtime"],
  "properties": {
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["python_version", "comfyui_revision", "pytorch"],
      "properties": {
        "python_version": { "type": "string", "minLength": 1 },
        "comfyui_revision": { "type": "string", "minLength": 1 },
        "pytorch": {
          "type": "object",
          "additionalProperties": false,
          "required": ["index_url", "packages"],
          "properties": {
            "index_url": { "type": "string", "minLength": 1 },
            "packages": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    }
  }
}
