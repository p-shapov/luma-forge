{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "luma-forge://schema/workflow_execution_contract",
  "title": "WorkflowExecutionContract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_ref", "input_bindings"],
  "properties": {
    "schema_ref": { "$ref": "luma-forge://schema/reference" },
    "input_bindings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["value", "node_id", "path"],
        "properties": {
          "value": true,
          "node_id": { "type": "string", "minLength": 1 },
          "path": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
