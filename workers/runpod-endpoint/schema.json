{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["runtime_preset", "runtime"],
  "additionalProperties": false,
  "properties": {
    "runtime_preset": {
      "type": "object",
      "required": ["id", "version"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" }
      }
    },
    "runtime": {
      "type": "object",
      "required": ["python_version", "comfyui_revision", "pytorch"],
      "additionalProperties": false,
      "properties": {
        "python_version": { "type": "string", "minLength": 1 },
        "comfyui_revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "pytorch": {
          "type": "object",
          "required": ["index_url", "packages"],
          "additionalProperties": false,
          "properties": {
            "index_url": { "type": "string", "format": "uri" },
            "packages": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    }
  }
}
